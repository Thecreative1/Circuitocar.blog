  var REDUCOES = [
    { maxAnos: 1,        pct: 10 },
    { maxAnos: 2,        pct: 20 },
    { maxAnos: 3,        pct: 28 },
    { maxAnos: 4,        pct: 35 },
    { maxAnos: 5,        pct: 43 },
    { maxAnos: 6,        pct: 52 },
    { maxAnos: 7,        pct: 60 },
    { maxAnos: 8,        pct: 65 },
    { maxAnos: 9,        pct: 70 },
    { maxAnos: 10,       pct: 75 },
    { maxAnos: Infinity, pct: 80 }
  ];

  function fmt(v) {
    return new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 }).format(v);
  }

  function taxa(v) {
    return v.toFixed(2).replace('.', ',');
  }

  function calcComponente(tabela, valor) {
    var entry = tabela.find(function(e) { return valor <= e.max; });
    if (!entry) return 0;
    return Math.max(0, valor * entry.rate - entry.deduct);
  }

  function getReducao(ano) {
    var anoAtual = new Date().getFullYear();
    var idade = anoAtual - ano;
    if (idade <= 0) return { pct: 0, anos: 0 };
    var entry = REDUCOES.find(function(e) { return idade <= e.maxAnos; });
    return { pct: entry ? entry.pct : 80, anos: idade };
  }

  function toggleParticulas() {
    var row = document.getElementById('rowParticulas');
    var isGasoleo = document.getElementById('combustivel').value === 'gasoleo';
    row.hidden = !isGasoleo;
    if (!isGasoleo) document.getElementById('particulasBaixas').checked = false;
  }

  function toggleOutrosCustos() {
    var cb = document.getElementById('incluirOutros');
    var bloco = document.getElementById('outrosCustos');
    bloco.classList.toggle('visible', cb.checked);
  }

  function calcularISV() {
    var aviso = document.getElementById('mensagemAviso');
    aviso.style.display = 'none';
    ['cilindrada','co2','anoMatricula'].forEach(function(id) {
      document.getElementById(id).removeAttribute('aria-invalid');
    });

    var cilindrada   = parseInt(document.getElementById('cilindrada').value)   || 0;
    var co2          = parseInt(document.getElementById('co2').value)           || 0;
    var ano          = parseInt(document.getElementById('anoMatricula').value)  || 0;
    var combustivel  = document.getElementById('combustivel').value;
    var norma        = document.getElementById('norma').value;
    var incluirOutros = document.getElementById('incluirOutros').checked;

    function invalidar(id, msg) {
      document.getElementById(id).setAttribute('aria-invalid', 'true');
      document.getElementById(id).focus();
      aviso.textContent = msg;
      aviso.style.display = 'block';
    }

    if (cilindrada < 500 || cilindrada > 9000) {
      invalidar('cilindrada', 'Introduza uma cilindrada válida (entre 500 e 9.000 cm³).');
      return;
    }
    if (co2 < 0 || co2 > 600) {
      invalidar('co2', 'Introduza um valor de CO2 válido (entre 0 e 600 g/km).');
      return;
    }
    if (ano < 1990 || ano > new Date().getFullYear()) {
      invalidar('anoMatricula', 'Introduza um ano de matrícula entre 1990 e ' + new Date().getFullYear() + '.');
      return;
    }

    var tabelaCO2Key = combustivel + '_' + norma;
    var compCil = calcComponente(ISV.cilindrada, cilindrada);
    var compCO2 = calcComponente(ISV[tabelaCO2Key], co2);
    var isvBase = compCil + compCO2;

    var reducao = getReducao(ano);
    var isvReduzido = isvBase * (1 - reducao.pct / 100);

    // Agravamento do gasoleo: 500 EUR sobre o montante total do imposto a pagar
    // (art. 7.o n.o 3 do CISV), excepto se o CoC indicar particulas < 0,001 g/km.
    var isentoParticulas = document.getElementById('particulasBaixas').checked;
    var agravamento = (combustivel === 'gasoleo' && !isentoParticulas) ? 500 : 0;
    var isvFinal = isvReduzido + agravamento;

    document.getElementById('rCompCilindrada').textContent = fmt(compCil);
    document.getElementById('rCompCO2').textContent        = fmt(compCO2);
    document.getElementById('rISVBase').textContent        = fmt(isvBase);
    document.getElementById('rISVFinal').textContent       = fmt(isvFinal);
    document.getElementById('rISVFinalNota').textContent   = agravamento
      ? 'Após redução por antiguidade, com agravamento de 500 € do gasóleo'
      : 'Após redução por antiguidade';

    var reducaoTexto = reducao.anos > 0
      ? reducao.anos + (reducao.anos === 1 ? ' ano' : ' anos') + ' de idade — redução de ' + reducao.pct + '%'
      : 'Carro do ano corrente — sem redução por antiguidade';
    document.getElementById('reducaoTexto').textContent = reducaoTexto;

    var normaLabel = norma.toUpperCase();
    var combLabel  = combustivel === 'gasoleo' ? 'Gasóleo' : 'Gasolina';
    var detalhe = document.getElementById('detalheCalculo');
    detalhe.innerHTML = [
      '<tr><td>Cilindrada: ' + cilindrada + ' cc × ' + taxa(ISV.cilindrada.find(function(e){return cilindrada<=e.max;}).rate) + ' €</td><td>' + fmt(cilindrada * ISV.cilindrada.find(function(e){return cilindrada<=e.max;}).rate) + '</td></tr>',
      '<tr class="deduct-row"><td>— Parcela a abater</td><td>− ' + fmt(ISV.cilindrada.find(function(e){return cilindrada<=e.max;}).deduct) + '</td></tr>',
      '<tr class="total-row"><td>Componente cilindrada</td><td>' + fmt(compCil) + '</td></tr>',
      '<tr><td>CO2: ' + co2 + ' g/km × ' + taxa(ISV[tabelaCO2Key].find(function(e){return co2<=e.max;}).rate) + ' € (' + combLabel + ' ' + normaLabel + ')</td><td>' + fmt(co2 * ISV[tabelaCO2Key].find(function(e){return co2<=e.max;}).rate) + '</td></tr>',
      '<tr class="deduct-row"><td>— Parcela a abater</td><td>− ' + fmt(ISV[tabelaCO2Key].find(function(e){return co2<=e.max;}).deduct) + '</td></tr>',
      '<tr class="total-row"><td>Componente ambiental CO2</td><td>' + fmt(compCO2) + '</td></tr>',
      '<tr><td><strong>ISV base (soma das componentes)</strong></td><td><strong>' + fmt(isvBase) + '</strong></td></tr>',
      '<tr class="deduct-row"><td>Redução por antiguidade (' + reducao.pct + '%)</td><td>− ' + fmt(isvBase * reducao.pct / 100) + '</td></tr>',
      agravamento ? '<tr><td>Agravamento gasóleo (art. 7.º n.º 3 do CISV)</td><td>+ ' + fmt(agravamento) + '</td></tr>' : '',
      '<tr class="total-row"><td><strong>ISV estimado a pagar</strong></td><td><strong>' + fmt(isvFinal) + '</strong></td></tr>'
    ].join('');

    var blocoTotal = document.getElementById('blocoTotal');
    if (incluirOutros) {
      var precoCompra    = parseFloat(document.getElementById('precoCompra').value)    || 0;
      var transporte     = parseFloat(document.getElementById('transporte').value)     || 0;
      var despachante    = parseFloat(document.getElementById('despachante').value)    || 0;
      var inspecaoLegal  = parseFloat(document.getElementById('inspecaoLegal').value)  || 0;
      var total = precoCompra + isvFinal + transporte + despachante + inspecaoLegal;
      document.getElementById('rTotal').textContent = fmt(total);
      var dt = document.getElementById('detalheTotal');
      dt.innerHTML = [
        precoCompra   ? '<tr><td>Preço de compra</td><td>' + fmt(precoCompra)   + '</td></tr>' : '',
        '<tr><td>ISV estimado</td><td>' + fmt(isvFinal) + '</td></tr>',
        transporte    ? '<tr><td>Transporte</td><td>' + fmt(transporte)    + '</td></tr>' : '',
        despachante   ? '<tr><td>Despachante</td><td>' + fmt(despachante)   + '</td></tr>' : '',
        inspecaoLegal ? '<tr><td>Inspeção B + legalização</td><td>' + fmt(inspecaoLegal) + '</td></tr>' : '',
        '<tr class="total-row"><td><strong>Total estimado</strong></td><td><strong>' + fmt(total) + '</strong></td></tr>'
      ].join('');
      blocoTotal.style.display = 'block';
    } else {
      blocoTotal.style.display = 'none';
    }

    var msgPartes = [
      'Olá, calculei o ISV no vosso simulador:',
      'Cilindrada: ' + cilindrada + ' cc | CO2: ' + co2 + ' g/km (' + combLabel + ', ' + normaLabel + ') | Ano: ' + ano,
      'Redução por antiguidade: ' + reducao.pct + '% (' + reducao.anos + ' anos)',
      'ISV estimado: ' + fmt(isvFinal)
    ];
    if (incluirOutros) {
      var precoC = parseFloat(document.getElementById('precoCompra').value) || 0;
      var totC   = precoC + isvFinal + (parseFloat(document.getElementById('transporte').value)||0) + (parseFloat(document.getElementById('despachante').value)||0) + (parseFloat(document.getElementById('inspecaoLegal').value)||0);
      if (precoC > 0) msgPartes.push('Preço compra: ' + fmt(precoC) + ' | Total estimado: ' + fmt(totC));
    }
    msgPartes.push('Gostava de perceber se compensa importar ou comprar diretamente em Portugal.');
    document.getElementById('btnWhatsApp').href = '{{ site.contact.marco.whatsappBase }}?text=' + encodeURIComponent(msgPartes.join('\n')) + '&utm_source=simulador&utm_medium=isv_resultado&utm_campaign=simulador_isv';

    var res = document.getElementById('resultados');
    res.classList.add('visible');
    if (window.lucide) lucide.createIcons({ attrs: { 'aria-hidden': 'true', focusable: 'false' } });
    res.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Mantem o limite do ano de matricula alinhado com o ano corrente.
  document.getElementById('anoMatricula').max = new Date().getFullYear();
  toggleParticulas();

  function resetSimulador() {
    ['cilindrada','co2','anoMatricula','precoCompra'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.value = '';
    });
    document.getElementById('combustivel').value = 'gasolina';
    document.getElementById('norma').value = 'wltp';
    toggleParticulas();
    document.getElementById('transporte').value = 400;
    document.getElementById('despachante').value = 350;
    document.getElementById('inspecaoLegal').value = 289;
    document.getElementById('incluirOutros').checked = false;
    document.getElementById('particulasBaixas').checked = false;
    document.getElementById('outrosCustos').classList.remove('visible');
    document.getElementById('resultados').classList.remove('visible');
    document.getElementById('mensagemAviso').style.display = 'none';
  }
  </script>

