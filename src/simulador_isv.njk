  <style>
    .sim-wrap { max-width: 1280px; margin: 0 auto; padding: 56px 32px 96px; display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 40px; align-items: start; }
    .sim-col { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
    .sim-card { background: var(--cc-paper-card); border: 1px solid var(--cc-border); border-radius: var(--cc-radius-lg); padding: 36px; }
    .sim-card h2 { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-black); text-transform: uppercase; font-size: clamp(26px, 2.6vw, 38px); line-height: 1.05; letter-spacing: var(--cc-tracking-tight); color: var(--cc-ink); margin: 0 0 10px; }
    .sim-card > p { font-family: var(--cc-font-body); font-size: var(--cc-fs-base); line-height: var(--cc-lh-loose); color: var(--cc-fg-muted); margin: 0 0 28px; max-width: 740px; }

    .sim-section-label { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-bold); font-size: var(--cc-fs-xs); color: var(--cc-fg-muted); letter-spacing: var(--cc-tracking-wider); text-transform: uppercase; margin: 28px 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--cc-border); display: block; }

    .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-bottom: 8px; }
    .form-grid--3 { grid-template-columns: repeat(3, 1fr); }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field label { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-bold); font-size: var(--cc-fs-xs); color: var(--cc-fg-muted); letter-spacing: var(--cc-tracking-wider); text-transform: uppercase; }
    .input, .select { font-family: var(--cc-font-body); font-size: var(--cc-fs-md); font-weight: var(--cc-fw-semibold); color: var(--cc-ink); background: var(--cc-paper-warm); border: 1px solid var(--cc-border-strong); border-radius: var(--cc-radius-sm); padding: 12px 14px; outline: none; transition: border-color var(--cc-dur-fast) var(--cc-ease-out), box-shadow var(--cc-dur-fast) var(--cc-ease-out); width: 100%; }
    .input:focus, .select:focus { border-color: var(--cc-ink); box-shadow: var(--cc-shadow-yellow); }
    .input[aria-invalid="true"] { border-color: var(--cc-signal-red); box-shadow: 0 0 0 3px rgba(229,52,43,0.15); }
    .field small { font-family: var(--cc-font-body); font-size: var(--cc-fs-xs); color: var(--cc-fg-subtle); line-height: 1.4; }

    .norma-hint { font-family: var(--cc-font-body); font-size: var(--cc-fs-xs); color: var(--cc-fg-subtle); background: var(--cc-paper-warm); border: 1px solid var(--cc-border); border-radius: var(--cc-radius-sm); padding: 10px 14px; line-height: 1.5; margin-bottom: 20px; }
    .norma-hint strong { color: var(--cc-ink); }

    .toggle-row { display: flex; align-items: center; gap: 10px; margin: 4px 0 14px; cursor: pointer; }
    .toggle-row input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--cc-ink); cursor: pointer; flex-shrink: 0; }
    .toggle-row span { font-family: var(--cc-font-body); font-size: var(--cc-fs-sm); color: var(--cc-fg-muted); }
    .toggle-row[hidden] { display: none; }

    .outros-custos { display: none; }
    .outros-custos.visible { display: block; }

    .calc-actions { display: flex; gap: 10px; flex-wrap: wrap; margin: 24px 0 28px; padding-top: 8px; }

    .resultados { display: none; }
    .resultados.visible { display: block; }

    .result-section-label { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-bold); font-size: var(--cc-fs-xs); color: var(--cc-fg-muted); letter-spacing: var(--cc-tracking-wider); text-transform: uppercase; margin: 24px 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--cc-border); display: block; }

    .result-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 20px; }
    .result-box { background: var(--cc-paper-warm); border: 1px solid var(--cc-border); border-radius: var(--cc-radius-md); padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
    .result-box strong { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-bold); font-size: var(--cc-fs-xs); color: var(--cc-fg-muted); letter-spacing: var(--cc-tracking-wider); text-transform: uppercase; }
    .result-box span { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-black); font-size: var(--cc-fs-2xl); color: var(--cc-ink); letter-spacing: 0; line-height: 1; -webkit-font-smoothing: subpixel-antialiased; font-variant-numeric: tabular-nums; }
    .result-box small { font-family: var(--cc-font-body); font-size: var(--cc-fs-xs); color: var(--cc-fg-subtle); line-height: 1.4; }
    .result-box.highlight { background: var(--cc-ink); border-color: var(--cc-ink); }
    .result-box.highlight strong { color: var(--cc-yellow); }
    .result-box.highlight span { color: var(--cc-yellow); font-size: var(--cc-fs-3xl); }
    .result-box.highlight small { color: rgba(255,255,255,0.55); }
    .result-box.total { background: var(--cc-blue-mid); border-color: var(--cc-blue-mid); grid-column: 1 / -1; }
    .result-box.total strong { color: rgba(255,255,255,0.7); }
    .result-box.total span { color: #fff; font-size: var(--cc-fs-3xl); }
    .result-box.total small { color: rgba(255,255,255,0.55); }

    .reducao-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--cc-yellow-tint); border: 1px solid var(--cc-yellow); border-radius: var(--cc-radius-sm); padding: 6px 12px; font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-bold); font-size: var(--cc-fs-xs); color: var(--cc-ink); letter-spacing: 0.06em; margin-bottom: 16px; }

    .breakdown-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-family: var(--cc-font-body); font-size: var(--cc-fs-sm); }
    .breakdown-table td { padding: 8px 12px; border-bottom: 1px solid var(--cc-border); color: var(--cc-ink); }
    .breakdown-table td:last-child { text-align: right; font-weight: var(--cc-fw-semibold); font-variant-numeric: tabular-nums; }
    .breakdown-table tr.total-row td { font-weight: var(--cc-fw-bold); border-top: 2px solid var(--cc-border-strong); border-bottom: none; }
    .breakdown-table tr.deduct-row td { color: var(--cc-fg-muted); }

    .note { background: var(--cc-yellow-tint); border-left: 4px solid var(--cc-yellow); border-radius: 0 var(--cc-radius-md) var(--cc-radius-md) 0; padding: 16px 20px; font-family: var(--cc-font-body); font-size: var(--cc-fs-sm); line-height: 1.6; color: var(--cc-ink); margin-top: 20px; }
    .note strong { color: var(--cc-ink) !important; font-weight: var(--cc-fw-bold); }

    .warning { background: rgba(229,52,43,0.08); border: 1px solid rgba(229,52,43,0.3); border-radius: var(--cc-radius-sm); padding: 12px 16px; font-family: var(--cc-font-body); font-size: var(--cc-fs-sm); color: var(--cc-signal-red); margin-top: 14px; font-weight: var(--cc-fw-semibold); }

    .wa-cta-block { background: var(--cc-paper-warm); border: 1px solid var(--cc-border); border-radius: var(--cc-radius-md); padding: 20px; margin-top: 20px; }
    .wa-cta-block p { font-family: var(--cc-font-body); font-size: var(--cc-fs-sm); color: var(--cc-fg-muted); margin: 0 0 14px; line-height: 1.5; }

    /* Explicacoes + FAQ (coluna principal, por baixo do simulador) */
    .faq-card h3 { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-black); text-transform: uppercase; font-size: var(--cc-fs-lg); line-height: 1.15; color: var(--cc-ink); margin: 28px 0 8px; }
    .faq-card h3:first-of-type { margin-top: 0; }
    .faq-card p { font-family: var(--cc-font-body); font-size: var(--cc-fs-base); line-height: var(--cc-lh-loose); color: var(--cc-fg-muted); margin: 0; max-width: 720px; }
    .faq-card p + p { margin-top: 10px; }
    .faq-card a { color: var(--cc-ink); font-weight: var(--cc-fw-bold); }

    .sim-outro { grid-column: 1 / -1; }
    .next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .next-card { display: flex; flex-direction: column; gap: 6px; background: var(--cc-paper-warm); border: 1px solid var(--cc-border); border-radius: var(--cc-radius-md); padding: 18px 20px; text-decoration: none; transition: border-color var(--cc-dur-fast) var(--cc-ease-out), background var(--cc-dur-fast) var(--cc-ease-out), transform var(--cc-dur-fast) var(--cc-ease-out); }
    .next-card:hover { border-color: var(--cc-ink); background: var(--cc-paper-card); transform: translateY(-2px); }
    .next-card:focus-visible { outline: 2px solid var(--cc-blue-light); outline-offset: 2px; }
    .next-card__eyebrow { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-bold); font-size: 10px; letter-spacing: var(--cc-tracking-wider); text-transform: uppercase; color: var(--cc-fg-subtle); }
    .next-card strong { font-family: var(--cc-font-display); font-style: italic; font-weight: var(--cc-fw-black); text-transform: uppercase; font-size: var(--cc-fs-md); line-height: 1.15; color: var(--cc-ink); }
    .next-card span:last-child { font-family: var(--cc-font-body); font-size: var(--cc-fs-xs); line-height: 1.5; color: var(--cc-fg-muted); }

    @media (max-width: 1000px) {
      .sim-wrap { grid-template-columns: 1fr; padding: 40px 24px 80px; }
    }
    @media (max-width: 640px) {
      .sim-wrap { padding: 32px 16px 72px; }
      .sim-card { padding: 24px; }
      .form-grid, .form-grid--3, .result-grid, .next-grid { grid-template-columns: 1fr; }
      .calc-actions { flex-direction: column; }
      .calc-actions .cc-btn { width: 100%; }
      .field, .input, .select { min-width: 0; }
    }
  </style>
